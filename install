#!/usr/bin/env bash

set -e

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="install.conf.yaml"
DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"

cd "${BASEDIR}"

# Pass 'info' command directly to dependency manager
if [ "$1" = "info" ]; then
  shift
  python3 scripts/setup/check_deps.py info "$@"
  exit 0
fi

# Pass '--check-only' command directly
if [ "$1" = "--check-only" ]; then
  python3 scripts/setup/check_deps.py
  exit 0
fi

echo "================================================================"
echo " Dotfiles Installation & Setup Bootstrapper"
echo "================================================================"

# Step 1: System Dependency & Package Resolution
set +e
python3 scripts/setup/check_deps.py --exit-code "$@"
DEPS_STATUS=$?
set -e

if [ $DEPS_STATUS -eq 2 ]; then
  echo ""
  read -p "Proceed with Dotbot configuration symlinking anyway? [y/N] " -n 1 -r REPLY
  echo ""
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Dotbot symlinking skipped. Install missing packages above, then rerun ./install."
    exit 0
  fi
else
  echo ""
  read -p "Proceed with Dotbot configuration symlinking? [Y/n] " -n 1 -r REPLY
  echo ""
  if [[ $REPLY =~ ^[Nn]$ ]]; then
    echo "Dotbot symlinking cancelled by user."
    exit 0
  fi
fi

echo ""
echo "[Phase 2] Initializing Dotbot submodules..."
git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive
git submodule update --init --recursive "${DOTBOT_DIR}"

echo "[Phase 2] Symlinking configuration files via Dotbot..."
"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" || echo "Warning: Dotbot reported some link warnings."

echo ""
echo "[Phase 3] Executing Post-Installation Setup..."
bash scripts/setup/post_install.sh
